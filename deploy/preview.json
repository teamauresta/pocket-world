{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "web",
        "namespace": "pocket-world-preview",
        "labels": {
          "app": "pocket-world",
          "preview": "private"
        }
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "pocket-world",
            "component": "web"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "pocket-world",
              "component": "web"
            }
          },
          "spec": {
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 1000,
              "runAsGroup": 1000,
              "fsGroup": 1000
            },
            "containers": [
              {
                "name": "web",
                "image": "python@sha256:423ed6ab25b1921a477529254bfeeabf5855151dc2c3141699a1bfc852199fbf",
                "command": [
                  "python",
                  "/app/server.py"
                ],
                "env": [
                  {
                    "name": "SITE_ROOT",
                    "value": "/site/releases/r-20261015-approved-a5d17b73cc8c"
                  }
                ],
                "ports": [
                  {
                    "containerPort": 8080
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "512Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "assets",
                    "mountPath": "/site",
                    "readOnly": true
                  },
                  {
                    "name": "server",
                    "mountPath": "/app",
                    "readOnly": true
                  }
                ],
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/index.html",
                    "port": 8080
                  },
                  "initialDelaySeconds": 2,
                  "periodSeconds": 5
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/index.html",
                    "port": 8080
                  },
                  "initialDelaySeconds": 10,
                  "periodSeconds": 15
                }
              }
            ],
            "volumes": [
              {
                "name": "assets",
                "persistentVolumeClaim": {
                  "claimName": "assets"
                }
              },
              {
                "name": "server",
                "configMap": {
                  "name": "server"
                }
              }
            ],
            "automountServiceAccountToken": false
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "web",
        "namespace": "pocket-world-preview",
        "labels": {
          "app": "pocket-world",
          "preview": "private"
        }
      },
      "spec": {
        "type": "ClusterIP",
        "selector": {
          "app": "pocket-world",
          "component": "web"
        },
        "ports": [
          {
            "port": 8080,
            "targetPort": 8080
          }
        ]
      }
    }
  ]
}
